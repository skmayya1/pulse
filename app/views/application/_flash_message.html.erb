<%# locals: (flash_message:) %>

<% type, message = flash_message %>
<% error = type.to_s == "alert" %>
<% delay_ms = 5000 %>

<div
  class="alert <%= error ? "alert-error" : "alert-success" %> shadow-lg"
  data-auto-dismiss-delay-value="<%= delay_ms %>"
  data-controller="auto-dismiss"
  role="<%= error ? "alert" : "status" %>"
  style="--auto-dismiss-ms: <%= delay_ms %>"
>
  <i
    class="ti <%= error ? "ti-alert-circle" : "ti-circle-check" %> text-lg"
    aria-hidden="true"
  ></i>

  <div class="flex min-w-0 items-start justify-between gap-2">
    <span><%= message %></span>

    <button
      type="button"
      class="btn btn-ghost btn-xs btn-circle text-current"
      data-action="auto-dismiss#dismiss"
      aria-label="Dismiss notification"
    >
      <i class="ti ti-x text-base" aria-hidden="true"></i>
    </button>
  </div>
</div>
