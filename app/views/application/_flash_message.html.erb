<%# locals: (flash_message:) %>

<% type, message = flash_message %>
<% error = type.to_s == "alert" %>

<div
  class="alert <%= error ? "alert-error" : "alert-success" %> shadow-lg"
  data-auto-dismiss-delay-value="5000"
  data-controller="auto-dismiss"
  role="<%= error ? "alert" : "status" %>"
>
  <i
    class="ti <%= error ? "ti-alert-circle" : "ti-circle-check" %> text-lg"
    aria-hidden="true"
  ></i>

  <span><%= message %></span>
</div>
