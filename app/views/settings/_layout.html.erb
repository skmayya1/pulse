<%# locals: (page:) %>

<main class="min-h-screen bg-base-100">
  <div class="drawer">
    <input id="settings-drawer" type="checkbox" class="drawer-toggle lg:hidden">

    <div class="drawer-content min-w-0">
      <header class="navbar min-h-16 border-b border-base-300 px-4 lg:hidden">
        <label
          for="settings-drawer"
          aria-label="Open settings navigation"
          class="btn btn-square btn-ghost drawer-button"
        >
          <i class="ti ti-menu-2 text-xl" aria-hidden="true"></i>
        </label>
      </header>

      <div class="mx-auto max-w-7xl px-4 py-4 lg:px-8 lg:py-10">
        <header class="flex items-center gap-3">
          <%= link_to root_path, class: "btn btn-ghost btn-sm btn-square", aria: {label: "Back to Pulse"} do %>
            <i class="ti ti-arrow-left text-lg" aria-hidden="true"></i>
          <% end %>

          <h1 class="text-lg font-semibold text-base-content">
            Settings
          </h1>
        </header>

        <div class="lg:mt-8 lg:grid lg:grid-cols-[12rem_minmax(0,1fr)] lg:gap-10">
          <aside class="hidden pt-2 lg:block">
            <%= render "settings/navigation", page: page %>
          </aside>

          <section class="min-w-0 bg-base-100 py-6 lg:p-12">
            <%= yield %>
          </section>
        </div>
      </div>
    </div>

    <div class="drawer-side z-50 lg:hidden">
      <label
        for="settings-drawer"
        aria-label="Close settings navigation"
        class="drawer-overlay"
      ></label>

      <aside class="min-h-full w-72 bg-base-100 p-6">
        <header class="mb-8 flex items-center justify-between">
          <h2 class="text-lg font-semibold text-base-content">Settings</h2>

          <label
            for="settings-drawer"
            aria-label="Close settings navigation"
            class="btn btn-square btn-ghost btn-sm"
          >
            <i class="ti ti-x text-lg" aria-hidden="true"></i>
          </label>
        </header>

        <%= render "settings/navigation", page: page %>
      </aside>
    </div>
  </div>
</main>
