<%# locals: (media:) %>

<dialog
  id="create_media_modal"
  class="modal"
  <%= "open" if media.errors.any? %>
>
  <div class="modal-box border border-base-300">
    <h2 class="text-lg font-semibold text-base-content">Create media</h2>

    <%= form_with model: media,
      url: media_index_path,
      class: "mt-6 space-y-5",
      data: {turbo_frame: "_top"} do |form| %>
      <% if media.errors.any? %>
        <div class="alert alert-error" role="alert">
          <span><%= media.errors.full_messages.to_sentence %></span>
        </div>
      <% end %>

      <fieldset
        class="fieldset"
        data-controller="preview"
        data-preview-max-value="<%= Media::MAX_BATCH %>"
      >
        <%= form.label :files, "Files", class: "fieldset-legend" %>

        <%= form.file_field :files,
          multiple: true,
          required: true,
          include_hidden: false,
          accept: (Media::IMAGE_CONTENT_TYPES + Media::VIDEO_CONTENT_TYPES).join(","),
          class: "file-input w-full",
          data: {preview_target: "input", action: "change->preview#show"} %>

        <p class="label text-base-content/60">
          Up to <%= Media::MAX_BATCH %> images or videos at a time.
        </p>

        <div data-preview-target="list" class="mt-3 flex flex-wrap gap-2"></div>
      </fieldset>

      <fieldset class="fieldset">
        <%= form.label :filename, "Filename", class: "fieldset-legend" %>

        <%= form.text_field :filename,
          class: "input w-full",
          placeholder: "Leave blank to use the file name" %>

        <p class="label text-base-content/60">
          Optional. Defaults to the uploaded file’s name.
        </p>
      </fieldset>

      <div class="modal-action">
        <button
          type="button"
          class="btn btn-ghost"
          onclick="this.closest('dialog').close()"
        >
          Cancel
        </button>

        <%= form.submit "Upload", class: "btn btn-accent" %>
      </div>
    <% end %>
  </div>

  <form method="dialog" class="modal-backdrop">
    <button type="submit">Close</button>
  </form>
</dialog>
