<%# locals: (media_records:, next_cursor:, query:, time_zone:) %>

<% if media_records.empty? && query.blank? %>
  <p class="text-sm text-base-content/60">
    No media yet. Create media to add files to this library.
  </p>
<% elsif media_records.empty? %>
  <p class="text-sm text-base-content/60">No media matches that filename.</p>
<% else %>
  <div class="w-full overflow-x-auto">
    <div id="media_rows" class="w-full min-w-[40rem]">
      <div
        class="
          grid h-10 w-full items-center gap-x-4 border-b border-base-300
          text-xs font-semibold text-base-content/60
        "
        style="grid-template-columns: minmax(8rem, 24rem) 5.5rem minmax(7rem, 1fr) minmax(8rem, 1fr) minmax(7rem, 1fr);"
      >
        <div class="flex min-w-0 items-center px-4">Filename</div>
        <div class="flex items-center px-2">Preview</div>
        <div class="flex items-center px-4">Updated</div>
        <div class="flex items-center px-4">Created by</div>
        <div class="flex items-center px-4">Created</div>
      </div>

      <%= render "media/page", media_records:, next_cursor:, query:, time_zone: %>
    </div>
  </div>
<% end %>
