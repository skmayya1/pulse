<!DOCTYPE html>

<html>
  <head>
    <title><%= content_for(:title) || "Pulse" %></title>

    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#ffffff">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link
      href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.46.0/dist/tabler-icons.min.css"
      rel="stylesheet"
    >

    <style>
      @font-face {
        font-family: "Inter";
        font-style: normal;
        font-display: swap;
        font-weight: 100 900;
        src: url("<%= asset_path("inter-variable.ttf") %>") format("truetype");
      }

      @font-face {
        font-family: "Inter";
        font-style: italic;
        font-display: swap;
        font-weight: 100 900;
        src: url("<%= asset_path("inter-variable-italic.ttf") %>") format("truetype");
      }
    </style>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body>
    <%= render "application/flash", flash_messages: flash.to_hash.slice("notice", "alert") %>

    <%= yield %>
  </body>
</html>
