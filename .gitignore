# Local reference repositories
.repo/*
!.repo/README.md

# Local environment configuration
.env
.env.*
!.env.example

# Ignore key files for decrypting credentials and more.
/config/*.key


/app/assets/builds/*
!/app/assets/builds/.keep

/node_modules

# Runtime files
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep
!/tmp/pids/
!/tmp/pids/.keep
/tmp/pids/*.pid
/storage/*
!/storage/.keep

# Local tooling and test output
/.bundle
/vendor/bundle
/coverage
.byebug_history
.DS_Store
.ruby-lsp/
/.dev/
nvim.log
